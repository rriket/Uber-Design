{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Services UP",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "sum(up)"}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": 0}, {"color": "green", "value": 1}]}}}
    },
    {
      "type": "timeseries",
      "title": "HTTP Requests / sec (by service)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [{
        "expr": "sum by(application) (rate(http_server_requests_seconds_count[1m]))",
        "legendFormat": "{{application}}"
      }]
    },
    {
      "type": "timeseries",
      "title": "HTTP P95 latency (seconds)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by(le, application) (rate(http_server_requests_seconds_bucket[1m])))",
        "legendFormat": "p95 {{application}}"
      }]
    },
    {
      "type": "timeseries",
      "title": "JVM heap used (MB)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [{
        "expr": "sum by(application) (jvm_memory_used_bytes{area=\"heap\"}) / 1024 / 1024",
        "legendFormat": "{{application}}"
      }]
    },
    {
      "type": "timeseries",
      "title": "HTTP error rate (5xx / sec)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [{
        "expr": "sum by(application) (rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))",
        "legendFormat": "{{application}}"
      }]
    }
  ],
