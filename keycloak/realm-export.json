{
  "realm": "uber-realm",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginTheme": "keycloak",
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      { "name": "RIDER", "description": "Rider role - can request rides" },
      { "name": "DRIVER", "description": "Driver role - can accept rides" }
    ]
  },
  "clients": [
    {
      "clientId": "uber-frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3000/*", "http://localhost:5173/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:5173", "+"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:5173/*"
      }
    },
    {
      "clientId": "uber-backend",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "secret": "uber-backend-secret"
    }
  ],
  "users": [
    {
      "username": "rider1",
      "enabled": true,
      "emailVerified": true,
      "email": "rider1@uber.local",
      "firstName": "Alice",
      "lastName": "Rider",
      "credentials": [
        { "type": "password", "value": "password", "temporary": false }
      ],
      "realmRoles": ["RIDER"]
    },
    {
      "username": "rider2",
      "enabled": true,
      "emailVerified": true,
      "email": "rider2@uber.local",
      "firstName": "Bob",
      "lastName": "Rider",
      "credentials": [
        { "type": "password", "value": "password", "temporary": false }
      ],
      "realmRoles": ["RIDER"]
    },
    {
      "username": "driver1",
      "enabled": true,
      "emailVerified": true,
      "email": "driver1@uber.local",
      "firstName": "Carlos",
      "lastName": "Driver",
      "attributes": {
        "vehicle_make": ["Tesla"],
        "vehicle_model": ["Model 3"],
        "vehicle_plate": ["UBR-001"]
      },
      "credentials": [
        { "type": "password", "value": "password", "temporary": false }
      ],
      "realmRoles": ["DRIVER"]
    },
    {
      "username": "driver2",
      "enabled": true,
      "emailVerified": true,
      "email": "driver2@uber.local",
      "firstName": "Diana",
      "lastName": "Driver",
      "attributes": {
        "vehicle_make": ["Toyota"],
        "vehicle_model": ["Camry"],
        "vehicle_plate": ["UBR-002"]
      },
      "credentials": [
        { "type": "password", "value": "password", "temporary": false }
      ],
      "realmRoles": ["DRIVER"]
    }
  ],
  "defaultDefaultClientScopes": ["role_list", "profile", "email", "roles", "web-origins"],
  "defaultOptionalClientScopes": ["offline_access"]
}
